rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.master == request.auth.uid
        && request.resource.data.max is int
        && request.resource.data.max >= 1 && request.resource.data.max <= 8;
      allow update, delete: if request.auth != null
        && resource.data.master == request.auth.uid;

      match /players/{pid} {
        allow read: if request.auth != null;
        // o jogador entra com a própria ficha; só o mestre altera depois
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(code))
          && pid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/rooms/$(code)).data.master == request.auth.uid;
      }

      match /dice/{d} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.resource.data.v is int
          && request.resource.data.v >= 1 && request.resource.data.v <= 20
          && (get(/databases/$(database)/documents/rooms/$(code)).data.master == request.auth.uid
              || exists(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid)));
      }
    }
  }
}
